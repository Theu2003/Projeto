{
  "name": "ecocoleta",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop application connecting residents with recycling collection companies",
  "main": "electron/main.ts",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:electron\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:electron": "electron-vite dev",
    "dev:client": "electron-vite dev --renderer-only",
    "build": "electron-vite build && npm run build --workspace=server",
    "preview": "electron-vite preview",
    "test": "npm run test --workspace=server",
    "test:frontend": "node tests/frontend-setup.test.js",
    "lint": "npm run lint --workspace=server"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-vite": "^2.3.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^4.1.10"
  }
}
