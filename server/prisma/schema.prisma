generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Morador (cliente) do sistema EcoColeta
model User {
  id                String    @id @default(cuid())
  name              String
  cpf               String    @unique
  phone             String
  email             String    @unique
  passwordHash      String
  role              String    @default("resident")
  address           String?
  latitude          Float?
  longitude         Float?
  points            Int       @default(0)
  active            Boolean   @default(true)
  resetCode         String?
  resetCodeExpiresAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  requests      CollectionRequest[] @relation("UserRequests")
  reviews       Review[]
  notifications Notification[]      @relation("UserNotifications")
  addresses     Address[]

  @@map("users")
}

/// Empresa de coleta seletiva
model Company {
  id                 String    @id @default(cuid())
  name               String
  cnpj               String    @unique
  responsible        String
  phone              String
  email              String    @unique
  passwordHash       String
  address            String?
  latitude           Float?
  longitude          Float?
  serviceAreaRadius  Float     @default(10)
  materials          String    @default("[]")
  approved           Boolean   @default(false)
  active             Boolean   @default(true)
  rating             Float     @default(0)
  resetCode          String?
  resetCodeExpiresAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  requests      CollectionRequest[] @relation("CompanyRequests")
  reviews       Review[]
  notifications Notification[]      @relation("CompanyNotifications")
  addresses     Address[]

  @@map("companies")
}

/// Solicitação de coleta de materiais recicláveis
model CollectionRequest {
  id           String   @id @default(cuid())
  userId       String
  companyId    String?
  status       String   @default("pending")
  materialType String
  quantityKg   Float
  observations String?
  photos       String   @default("[]")
  desiredDate  String?
  desiredTime  String?
  latitude     Float?
  longitude    Float?
  address      String?
  realWeight   Float?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User     @relation("UserRequests", fields: [userId], references: [id])
  company Company? @relation("CompanyRequests", fields: [companyId], references: [id])
  review  Review?

  @@map("collection_requests")
}

/// Catálogo de materiais recicláveis
model Material {
  id          String  @id @default(cuid())
  name        String
  icon        String
  category    String
  recyclable  Boolean @default(true)
  pointsPerKg Int

  @@map("materials")
}

/// Avaliação de empresa feita por morador após coleta
model Review {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  requestId String   @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id])
  company Company          @relation(fields: [companyId], references: [id])
  request CollectionRequest @relation(fields: [requestId], references: [id])

  @@map("reviews")
}

/// Notificação para usuários e empresas
model Notification {
  id        String   @id @default(cuid())
  userId    String?
  companyId String?
  type      String
  message   String
  read      Boolean  @default(false)
  data      String   @default("{}")
  createdAt DateTime @default(now())

  user    User?    @relation("UserNotifications", fields: [userId], references: [id])
  company Company? @relation("CompanyNotifications", fields: [companyId], references: [id])

  @@map("notifications")
}

/// Endereço (suporte a múltiplos endereços por usuário/empresa)
model Address {
  id           String  @id @default(cuid())
  userId       String?
  companyId    String?
  label        String
  street       String
  number       String
  neighborhood String
  city         String
  state        String
  zipCode      String
  latitude     Float?
  longitude    Float?
  isDefault    Boolean @default(false)

  user    User?    @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@map("addresses")
}
